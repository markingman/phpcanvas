<?xml version="1.0" encoding="UTF-8"?>
<!-- Run from: vendor/phpunit/phpunit/phpunit -->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	bootstrap="tests/bootstrap.php"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.2/phpunit.xsd"
	displayDetailsOnTestsThatTriggerDeprecations="true"
	displayDetailsOnTestsThatTriggerErrors="true"
	displayDetailsOnTestsThatTriggerNotices="true"
	displayDetailsOnTestsThatTriggerWarnings="true"
	displayDetailsOnPhpunitDeprecations="true"
	>
	<coverage includeUncoveredFiles="true" pathCoverage="false">
		<report>
			<html outputDirectory="phpunit-coverage" lowUpperBound="50" highLowerBound="90"/>
		</report>
	</coverage>
	<testsuites>
		<testsuite name="PHPCanvas Test Suite">
			<!--<file>tests/ApplicationTest.php</file>-->
			<!--<file>tests/ConfigTest.php</file>-->
			<!--<file>tests/ContainerTest.php</file>-->
			<file>tests/Controller/ControllerTest.php</file>
			<!--<file>tests/Errors/ErrorHandlerTest.php</file>-->
			<file>tests/Http/RequestTest.php</file>
			<!--<file>tests/Http/ResponseTest.php</file>-->
			<!--<file>tests/Logs/LogHandlerTest.php</file>-->
			<file>tests/Routing/DispatchTest.php</file>
			<file>tests/Routing/LinksTest.php</file>
			<file>tests/Routing/RouterTest.php</file>
			<!--<file>tests/Session/SessionHandlerTest.php</file>-->
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory>src</directory>
		</include>
	</source>
</phpunit>
