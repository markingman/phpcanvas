{
	"name": "markingman/phpcanvas",
	"description": "A lightweight PHP web application framework",
	"license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "PHPCanvas\\": ["src/classes/PHPCanvas", "tests/PHPCanvas"]
        },
	    "files": ["src/phpcanvas.php"]
    },
	"require-dev": {
		"phpunit/phpunit": "~11.4.2",
		"phpstan/phpstan": "~1.12"
	},
	"config": {
        "vendor-dir": "vendor"
    }
}
