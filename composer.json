{
  "name": "markingman/phpcanvas",
  "description": "A lightweight PHP web application framework",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*"
  },
  "autoload": {
    "psr-4": {
      "PHPCanvas\\": [
        "src"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PHPCanvas\\Test\\": [
        "tests/fixtures/classes",
        "tests/fixtures/app/classes"
      ],
      "PHPCanvas\\": [
        "tests/unit",
        "tests/integration"
      ]
    },
	"files": [
		"tests/integration/fixtures/app/app.php"
	]
  },
  "require-dev": {
    "phpunit/phpunit": "~11.4.2",
    "phpstan/phpstan": "~1.12",
    "guzzlehttp/guzzle": "^7.9"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
