{
  "name": "markingman/phpcanvas",
  "description": "A lightweight PHP web application framework",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*"
  },
  "autoload": {
    "psr-4": {
      "PHPCanvas\\": [
        "src/classes"
      ]
    },
    "files": [
      "src/phpcanvas.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "PHPCanvas\\Test\\": [
        "tests/fixtures/classes",
        "tests/fixtures/app/classes"
      ],
      "PHPCanvas\\": [
        "tests/unit"
      ]
    },
    "files": [
      "src/phpcanvas.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "~11.4.2",
    "phpstan/phpstan": "~1.12"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
